      "quest": {
        "pk": "PK 1",
        "title": "Adaptacja do zmian klimatu – Toruń wie, jak!",
        "time": "30 minut",
        "dist": "1 km",
        "tagline": "Toruń wie, jak!",
        "intro": "Quest zaczyna się przy wejściu do parku kieszonkowego Greckie Klimaty w Toruniu, ul. Rydygiera. Dowiesz się, jak działania można podjąć, by zaadaptować się do zmian klimatycznych.",
        "app": "www.Questy.org.pl",
        "code_hint": "Hasło końcowe jest czterocyfrowe. Wpisz je na stronie www.Questy.org.pl lub w aplikacji Questy.",
        "steps": [
          {
            "text": "Stoisz przy fontannie – zauważ, że woda jest tu ozdobna, ale też praktyczna. Poczytaj, jak fontanny wpływają na mikroklimat.",
            "answer": ""
          },
          {
            "text": "Znajdź punkt przed pustymi prostokątami podzielonymi pionowo. Obok roślin masz wiele rodzajów karmników – są to hotele dla zapylaczy.",
            "answer": ""
          },
          {
            "text": "Idź do tablicy karmnika dla ptaków – znajdź cyferkę do skarbu. Z prawej strony na jednej desce wpisz litery na zapylacze.",
            "answer": ""
          },
          {
            "text": "Policz ile koszy na odpady bio obok boksu się znajduje. Niech ta cyferka do kratki skoku wskoczy.",
            "answer": ""
          },
          {
            "text": "Specjalna nawierzchnia – na tablicy na tę zagadkę: co jest adaptacją do zmian klimatu, a tak możemy pomóc wodzie przepuszczać.",
            "answer": ""
          },
          {
            "text": "Złóż litery i wpisz hasło końcowe czterocyfrowe!",
            "answer": ""
          }
        ]
      }
    },
